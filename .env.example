# Copy this file to .env and fill in your real keys:
#   cp .env.example .env

# Three providers now, one key each — see supervisor/models/model_pool.py

# 1. Groq — default (fast) tier, llama-3.3-70b-versatile on LPU hardware.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. OpenRouter — escalation tier, DeepSeek V4 (flash + pro), tried first.
# Free key: https://openrouter.ai/keys (still requires a key even for
# paid models; a small balance, even $1, unlocks higher rate limits)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Google AI Studio — escalation tier, Gemini 3.6 Flash, the
# fallback-of-last-resort if both DeepSeek candidates fail.
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Langfuse — optional. Leave blank to run without tracing (nothing
# else changes — see supervisor/observability.py). Free account:
# https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- everything below has a sane default, override only if needed ---

# Gateway
GATEWAY_PORT=8080
SUPERVISOR_URL=http://localhost:50051

# Supervisor
SUPERVISOR_GRPC_PORT=50051
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REDIS_URL=redis://localhost:6379
ROUTE_CONFIDENCE_THRESHOLD=0.6
ESCALATION_CONFIDENCE_THRESHOLD=0.70
CACHE_SIMILARITY_THRESHOLD=0.92
