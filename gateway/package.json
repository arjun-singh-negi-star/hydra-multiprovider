{
  "name": "hydra-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HYDRA public-facing gateway — speaks Connect/gRPC/gRPC-Web to clients, pure gRPC to the Supervisor",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "proto:gen": "cd .. && buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
